# Copy to `.env` in server/ — never commit `.env`.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/carwale?retryWrites=true&w=majority

# JWT secret for user sessions
JWT_SECRET=your-long-random-secret

# Cloudinary — car & brand image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Legacy Cloudinary keys (used in some controllers)
CLOUD_NAME=
API_KEY=
API_SECRET=

# Braintree payment gateway (sandbox or production)
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
